{
  "version": "1.1",
  "description": "Ground truth trajectories for scoring agent tool calling quality. v1.1 adds expected_outcome for outcome-based scoring.",
  "ground_truths": [
    {
      "query": "Show NDVI for Berlin in 2024",
      "domain": "vegetation",
      "expected_tools": [
        "recommend_collection",
        "resolve_location",
        "openeo_parse_temporal",
        "openeo_generate_graph",
        "openeo_create_job",
        "openeo_start_job",
        "openeo_get_results",
        "viz_show_map"
      ],
      "expected_params": {
        "recommend_collection": {
          "description": "NDVI vegetation analysis"
        },
        "resolve_location": {
          "location_name": "Berlin"
        },
        "openeo_parse_temporal": {
          "description": "2024"
        },
        "openeo_generate_graph": {
          "description": "NDVI",
          "collection": "sentinel-2-l2a",
          "cloud_mask": true
        }
      },
      "acceptable_alternatives": [
        [
          "recommend_collection",
          "resolve_location",
          "openeo_parse_temporal",
          "openeo_compose_graph",
          "openeo_create_job",
          "openeo_start_job",
          "openeo_get_results",
          "viz_show_map"
        ]
      ],
      "expected_outcome": {
        "job_succeeded": true,
        "expected_format": "GTiff",
        "expected_bands": ["ndvi"],
        "value_range": [-1.0, 1.0],
        "has_spatial_extent": true,
        "has_temporal_extent": true,
        "min_tool_calls": 4,
        "max_tool_calls": 12,
        "required_capabilities": [
          "location_resolution",
          "graph_building",
          "job_execution",
          "result_retrieval"
        ]
      }
    },
