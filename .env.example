#!/bin/bash
# OpenEO FastAPI Environment Configuration

# macOS with Homebrew only, if psql and friends aren't on PATH:
# export PATH="/opt/homebrew/bin:/opt/homebrew/opt/postgresql@15/bin:$PATH"

# API Configuration
export API_DNS="localhost"
export API_TLS="False"
export API_TITLE="OpenEO API"
export API_DESCRIPTION="OpenEO FastAPI Implementation"
export OPENEO_VERSION="1.1.0"
export OPENEO_PREFIX="/openeo/1.1.0"

# OIDC Configuration (EGI Check-in for testing)
export OIDC_URL="https://aai.egi.eu/auth/realms/egi"
export OIDC_ORGANISATION="egi"

# STAC Catalogue (AWS Earth Search)
export STAC_API_URL="https://earth-search.aws.element84.com/v1/"

# AWS Configuration for anonymous access to public STAC data
export AWS_NO_SIGN_REQUEST="YES"
export AWS_REQUEST_PAYER="requester"

# Result Storage: job results and tool outputs. Defaults to ~/.openeo_results.
# Never /tmp: it is wiped on reboot, and on every restart of a service with PrivateTmp.
# export RESULT_STORAGE_PATH="$HOME/.openeo_results"

# Development Mode - Basic Auth with the password below, for local use only.
# Change the password, and never expose /openeo publicly with dev mode on (docs/deployment.md).
export OPENEO_DEV_MODE="true"
export OPENEO_DEV_USER_ID="dev-user-001"
export OPENEO_DEV_PASSWORD="changeme"

# PostgreSQL Configuration
# For Supabase, use the connection pooler (port 6543) for transaction-mode pooling
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
export POSTGRES_USER="postgres.your-project-ref"
export POSTGRES_PASSWORD="your-supabase-db-password"
export POSTGRESQL_HOST="aws-0-region.pooler.supabase.com"
export POSTGRESQL_PORT="6543"
export POSTGRES_DB="postgres"

# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
export SUPABASE_URL="https://your-project-ref.supabase.co"
export SUPABASE_ANON_KEY="sb_publishable_..."           # Public key, safe for frontend
export VITE_SUPABASE_URL="$SUPABASE_URL"                # Frontend Supabase URL for Vite
export VITE_SUPABASE_ANON_KEY="$SUPABASE_ANON_KEY"      # Frontend Supabase public anon key for Vite
export SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."        # Secret, backend only — NEVER expose
export SUPABASE_JWT_SECRET="your-jwt-secret"            # From API → JWT Settings, used to verify tokens

# Langfuse Observability (LLM tracing — Phase 16)
# Get keys from: Langfuse UI → Settings → API Keys
export LANGFUSE_PUBLIC_KEY="pk-lf-..."
export LANGFUSE_SECRET_KEY="sk-lf-..."
export LANGFUSE_HOST="https://cloud.langfuse.com"   # EU region; us.cloud.langfuse.com for US
# LangChain OTel bridge — forwards Claude Agent SDK spans to Langfuse
export LANGSMITH_OTEL_ENABLED="true"
export LANGSMITH_OTEL_ONLY="true"
export LANGSMITH_TRACING="true"

# Alembic Directory
export ALEMBIC_DIR="/path/to/JonaAI/openeo_app/psql"
export ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"
export EARTH_AGENT_API_KEY="sk-ant-api03-your-key-here"

# Admin Authentication (DEPRECATED — being replaced by Supabase Auth)
# Kept for backward compat during migration to Supabase Auth
export ADMIN_USERNAME="admin"
# Empty disables the admin login. Never deploy with a guessable value.
export ADMIN_PASSWORD=""

# OpenEO Backend URL (mounted inside AI web interface on same port)
export OPENEO_URL="http://localhost:8080/openeo/1.1.0"

# Model for every agent phase, and its effort (low, medium, high, xhigh, max)
export JONA_MODEL="claude-opus-5-5"
export JONA_EFFORT="max"

# Largest data cube one job may load (bands x time x y x x). Size it to the host:
# peak memory is several times elements x 4 bytes. Default 250000000 assumes a large host.
export OPENEO_MAX_LOAD_ELEMENTS="250000000"
# Jobs running at once; others wait for a slot. Default 4.
export OPENEO_MAX_CONCURRENT_JOBS="4"

# Claude Agent SDK backend (claude_sdk or anthropic)
export OPENEO_SDK_BACKEND="claude_sdk"

# Earth-Agent integration
export EARTH_AGENT_PYTHON="/path/to/JonaAI/Earth-Agent/.venv/bin/python3"
export ENABLE_EARTH_AGENT_DIRECT_TOOLS="true"

# GeoAI Model Inference
export GEOAI_MODELS_PATH="openeo_ai/geoai/models/"

# Earth Intelligence delivery dispatch (email channel; unset host = email deliveries fail cleanly)
export JONA_SMTP_HOST=""
export JONA_SMTP_PORT="587"
export JONA_SMTP_USER=""
export JONA_SMTP_PASSWORD=""
export JONA_SMTP_FROM=""
export JONA_SMTP_STARTTLS="true"
# Allow webhook/Slack targets on private/loopback addresses (local testing only)
export JONA_ALLOW_PRIVATE_WEBHOOKS="false"

# Spend limits, in dollars
export JONA_MAX_QUERY_USD=10
export JONA_USER_DAILY_USD=50
# Idle agent sessions hold about 250 MB each. They resume from history when ended.
export JONA_SDK_SESSION_TTL_SECONDS=1800
export JONA_SDK_SESSION_MAX_COUNT=100
# Refuse tool calls with no signed-in user. Set in any deployment.
export JONA_REQUIRE_TOOL_USER=true
# Returns memory to the system after large jobs.
export MALLOC_ARENA_MAX=2
# Service-wide spend per month, accounts accepted, and Cloudflare Access token checks.
# export JONA_MONTHLY_USD=100
# export JONA_ALLOWED_EMAILS=you@example.com
# export JONA_ACCESS_MODE=observe
# export JONA_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# export JONA_ACCESS_AUD=
# Offsite copies of saved results (needs rclone). Off unless set. See docs/deployment.md.
# export JONA_RESULT_COPIES=r2            # or: directory, with JONA_RESULT_COPIES_DIR=/path
# Account endpoint only, no bucket path. The bucket is a separate setting.
# An EU-jurisdiction bucket uses https://<account_id>.eu.r2.cloudflarestorage.com instead.
# export JONA_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# export JONA_R2_BUCKET=jonaai-results
# export JONA_R2_ACCESS_KEY_ID=
# export JONA_R2_SECRET_ACCESS_KEY=
# JonaAI's share of the R2 free allowance, in GB. The allowance belongs to the Cloudflare
# account and may be shared with other projects on it. These limits only count JonaAI's own copies;
# they can't see the account total, and going over the allowance is billed, not refused.
# export JONA_R2_HARD_LIMIT_GB=3
# export JONA_R2_SOFT_LIMIT_GB=2
# export JONA_R2_USER_LIMIT_GB=1
# Where interrupted query runs are logged for recovery (default ~/.jona_runs).
# export JONA_RUN_LOG_DIR=
